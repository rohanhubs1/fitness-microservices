# ==============================================================================
# PULSEFORGE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Rename this file to .env and supply your credentials before running docker compose
# ==============================================================================

# 1. PostgreSQL Cloud Database (Neon / AWS / Supabase)
POSTGRES_URL=jdbc:postgresql://your-neon-host.aws.neon.tech/fitness_user_db?sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your_postgres_password

# 2. MongoDB Atlas Cloud Database
MONGO_URI_ACTIVITY=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/fitness?appName=FitnessCluster
MONGO_URI_AI=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/fitnessrecommendation?appName=FitnessCluster

# 3. RabbitMQ Message Broker
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# 4. Grok / Groq AI Recommendation Engine (LLaMA 3.3)
GROK_API_URL=https://api.groq.com/openai/v1/chat/completions
GROK_API_KEY=gsk_your_groq_api_key_here
GROK_MODEL=llama-3.3-70b-versatile

# 5. Keycloak IAM & Auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_JWK_SET_URI=http://host.docker.internal:8181/realms/fitness-oauth2/protocol/openid-connect/certs

# 6. Service Discovery & Config Server
EUREKA_PORT=8761
CONFIG_SERVER_PORT=8888

# 7. Frontend URLs
VITE_API_URL=http://localhost:8080/api
VITE_KEYCLOAK_URL=http://localhost:8181
VITE_APP_URL=http://localhost:3000
